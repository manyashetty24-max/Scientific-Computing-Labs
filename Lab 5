    ne_states.isnull().sum().sum()
)


# ============================================================
# QUESTION 3
# REPROJECT ALL SHAPEFILES TO EPSG:4326
# PLOT AND SAVE AS NEW SHAPEFILES
# ============================================================

print("\n")
print("=" * 70)
