plt.show()


# ------------------------------------------------------------
# PLOT NE STATES
# HIGHLIGHT STATES USING DIFFERENT COLOURS
# ------------------------------------------------------------

fig, ax = plt.subplots(
    figsize=(10, 10)
)


# Check the state-name column
print("\nNE States columns:")
print(
    ne_states_4326.columns.tolist()
)


# Plot states
ne_states_4326.plot(
    ax=ax,
    column="State_Name",
    categorical=True,
    legend=True,
    edgecolor="black",
    linewidth=0.8
)


# Add state labels
for index, row in ne_states_4326.iterrows():

    point = row.geometry.representative_point()

    ax.annotate(
        text=row["State_Name"],
        xy=(point.x, point.y),
        ha="center",
        va="center",
        fontsize=8
    )


ax.set_title(
    "North Eastern States of India - EPSG:4326",
    fontsize=14
)


ax.set_xlabel(
    "Longitude"
)


ax.set_ylabel(
    "Latitude"
)


plt.tight_layout()


plt.savefig(
    os.path.join(
        OUTPUT_FOLDER,
        "NE_States_EPSG4326.png"
    ),
    dpi=300
)


plt.show()


# ============================================================
# QUESTION 4
# CALCULATE AREAS OF NORTH EASTERN STATES
# SORT DESCENDING
# PLOT BAR CHART
# ============================================================

print("\n")
print("=" * 70)
print("QUESTION 4 - AREA OF NORTH EASTERN STATES")
print("=" * 70)


# IMPORTANT:
#
# EPSG:4326 is a geographic CRS.
# Its coordinates are in degrees.
#
# Therefore, we should NOT calculate area directly
# using EPSG:4326.
#
# EPSG:6933 is an equal-area CRS and is used here
# for area calculation.
# ------------------------------------------------------------


ne_area = ne_states_4326.to_crs(
    epsg=6933
)


# Calculate area in square metres
ne_area["Area_m2"] = (
    ne_area.geometry.area
)


# Convert square metres to square kilometres
ne_area["Area_km2"] = (
    ne_area["Area_m2"] / 1_000_000
)


# Sort from largest to smallest
ne_area_sorted = ne_area.sort_values(
    by="Area_km2",
    ascending=False
)


# ------------------------------------------------------------
# PRINT TABLE
# ------------------------------------------------------------

print("\nArea of North Eastern States:")
print(
    ne_area_sorted[
        ["State_Name", "Area_km2"]
    ].to_string(index=False)
)


# ------------------------------------------------------------
# SAVE AREA TABLE
# ------------------------------------------------------------

ne_area_sorted[
    ["State_Name", "Area_km2"]
].to_csv(
    os.path.join(
        OUTPUT_FOLDER,
        "North_Eastern_State_Areas.csv"
    ),
    index=False
)


# ------------------------------------------------------------
# BAR CHART
# ------------------------------------------------------------

plt.figure(
    figsize=(11, 6)
)


plt.bar(
    ne_area_sorted["State_Name"],
    ne_area_sorted["Area_km2"]
)


plt.title(
    "Area of North Eastern States",
    fontsize=14
)


plt.xlabel(
    "State"
)


plt.ylabel(
    "Area (km²)"
)


plt.xticks(
    rotation=45,
    ha="right"
)


plt.tight_layout()


plt.savefig(
    os.path.join(
        OUTPUT_FOLDER,
        "North_Eastern_State_Areas.png"
    ),
    dpi=300
)


plt.show()


