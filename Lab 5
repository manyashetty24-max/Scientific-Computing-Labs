# QUESTION 7
# DISTRICT AREAS OF KARNATAKA
# ============================================================

print("\n")
print("=" * 70)
print("QUESTION 7 - KARNATAKA DISTRICT AREAS")
print("=" * 70)


# ------------------------------------------------------------
# GADM LEVEL 2
# Level 2 contains district boundaries
# ------------------------------------------------------------


gadm_level2_files = glob.glob(
    os.path.join(
        BASE_FOLDER,
        "**",
        "*_IND_2.shp"
    ),
    recursive=True
)


if len(gadm_level2_files) == 0:

    print(
        "\nGADM Level 2 shapefile was not found."
    )

    print(
        "\nPlease download the India Level-2 "
        "GADM shapefile."
    )


else:

    GADM_LEVEL2_PATH = gadm_level2_files[0]


    print(
        "\nGADM Level 2 file:"
    )


    print(
        GADM_LEVEL2_PATH
    )


    # Read districts
    districts = gpd.read_file(
        GADM_LEVEL2_PATH
    )


    print(
        "\nDistrict shapefile columns:"
    )


    print(
        districts.columns.tolist()
    )


    # --------------------------------------------------------
    # SELECT KARNATAKA DISTRICTS
    # --------------------------------------------------------

    karnataka_districts = districts[
        districts["NAME_1"].str.lower()
        == "karnataka"
    ].copy()


    if karnataka_districts.empty:

        print(
            "\nNo Karnataka districts found."
        )


    else:

        print(
            "\nNumber of Karnataka districts:"
        )


        print(
            len(karnataka_districts)
        )


        # ----------------------------------------------------
        # REPROJECT FOR AREA CALCULATION
        # ----------------------------------------------------

        karnataka_projected = (
            karnataka_districts.to_crs(
                epsg=6933
            )
        )


        # ----------------------------------------------------
        # CALCULATE AREA
        # ----------------------------------------------------

        karnataka_projected[
            "Area_km2"
        ] = (
            karnataka_projected.geometry.area
            / 1_000_000
        )


        # ----------------------------------------------------
        # SORT DISTRICTS
        # ----------------------------------------------------

        district_area = (
            karnataka_projected
            .sort_values(
                by="Area_km2",
                ascending=False
            )
        )


        # ----------------------------------------------------
        # PRINT DISTRICT AREA TABLE
        # ----------------------------------------------------

        print(
            "\nKarnataka District Areas:"
        )


        print(
            district_area[
                [
                    "NAME_2",
                    "Area_km2"
                ]
            ].to_string(
                index=False
            )
        )


        # ----------------------------------------------------
        # SAVE DISTRICT AREA TABLE
        # ----------------------------------------------------

        district_area[
            [
                "NAME_2",
                "Area_km2"
            ]
        ].to_csv(
            os.path.join(
                OUTPUT_FOLDER,
                "Karnataka_District_Areas.csv"
            ),
            index=False
        )


        # ----------------------------------------------------
        # CREATE BAR CHART
        # ----------------------------------------------------

        plt.figure(
            figsize=(14, 7)
        )


        plt.bar(
            district_area["NAME_2"],
            district_area["Area_km2"]
        )


        plt.title(
            "Area of Districts in Karnataka",
            fontsize=14
        )


        plt.xlabel(
            "District"
        )


        plt.ylabel(
            "Area (km²)"
        )


        plt.xticks(
            rotation=90
        )


        plt.tight_layout()


        # Save bar chart
        plt.savefig(
            os.path.join(
                OUTPUT_FOLDER,
                "Karnataka_District_Areas.png"
            ),
            dpi=300
        )


        plt.show()


