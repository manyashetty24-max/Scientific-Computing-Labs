    epsg=4326
)


print("\nNew CRS of Meghalaya:")
print(
    meghalaya_4326.crs
)


print("\nNew CRS of NE States:")
print(
    ne_states_4326.crs
)


# ------------------------------------------------------------
# SAVE REPROJECTED SHAPEFILES
# ------------------------------------------------------------

meghalaya_output = os.path.join(
    OUTPUT_FOLDER,
    "Meghalaya_EPSG4326.shp"
)


