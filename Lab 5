    OUTPUT_FOLDER,
    "NE_States_EPSG4326.shp"
)


meghalaya_4326.to_file(
    meghalaya_output
)


ne_states_4326.to_file(
    ne_output
)


print("\nReprojected Meghalaya saved to:")
print(meghalaya_output)


print("\nReprojected NE States saved to:")
print(ne_output)


# ------------------------------------------------------------
# PLOT MEGHALAYA
# ------------------------------------------------------------

fig, ax = plt.subplots(
