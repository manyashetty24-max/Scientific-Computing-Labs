# ============================================================
# Q7 - NDVI
#
# NDVI = (NIR - RED) / (NIR + RED)
#
# NIR = B08
# RED = B04
# ============================================================

print("\n========== Q7: NDVI ==========")


nir_float = nir.astype(
    np.float32
)

red_float = red.astype(
    np.float32
)


denominator = (
    nir_float + red_float
)


ndvi = np.divide(
    nir_float - red_float,
    denominator,
    out=np.zeros_like(
        nir_float,
        dtype=np.float32
    ),
    where=denominator != 0
)


print(
    "Minimum NDVI:",
    np.min(ndvi)
)

print(
    "Maximum NDVI:",
    np.max(ndvi)
)

print(
    "Mean NDVI:",
    np.mean(ndvi)
)


# ============================================================
# DISPLAY NDVI
# ============================================================

