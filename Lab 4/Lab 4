    vmax=1
)

plt.title(
    "Vegetation Map - NDVI Threshold = 0.3"
)

plt.colorbar(
    ticks=[0, 1],
    label="0 = No Vegetation, 1 = Vegetation"
)

plt.axis("off")

plt.show()


# ============================================================
# CALCULATE VEGETATION AREA
# ============================================================

vegetation_pixels = np.sum(
    vegetation == 1
)


with rasterio.open(red_path) as src:

    pixel_width = src.res[0]

    pixel_height = src.res[1]


pixel_area = (
    pixel_width *
    pixel_height
)


vegetation_area_m2 = (
    vegetation_pixels *
    pixel_area
)


vegetation_area_hectares = (
    vegetation_area_m2 /
    10000
)


vegetation_area_km2 = (
    vegetation_area_m2 /
    1000000
)


