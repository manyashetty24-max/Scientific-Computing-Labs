# ============================================================
# IMAGE STRETCHING FUNCTION
# Used only for displaying RGB images
# ============================================================

def stretch(image):

    image = image.astype(np.float32)

    low = np.percentile(
        image,
        2
    )

    high = np.percentile(
        image,
        98
    )

    image = np.clip(
        image,
        low,
        high
    )

    if high != low:

        image = (
            image - low
        ) / (
            high - low
        )

    else:

        image = np.zeros_like(
            image,
            dtype=np.float32
        )

    return image


# ============================================================
# STRETCH BANDS
