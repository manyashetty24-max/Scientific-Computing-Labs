    figsize=(8, 8)
)

plt.imshow(
    ndvi,
    cmap="RdYlGn",
    vmin=-1,
    vmax=1
)

plt.colorbar(
    label="NDVI"
)

plt.title(
    "Sentinel-2 NDVI Map"
)

plt.axis("off")

plt.show()


# ============================================================
# Q7 - NDVI THRESHOLDING
#
# 0 = NO VEGETATION
# 1 = VEGETATION
# ============================================================

threshold = 0.3


vegetation = np.where(
    ndvi >= threshold,
    1,
    0
)


